# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database: PostgreSQL connection string
DATABASE_URL=postgres://postgres:Tencent2025@localhost:5432/genie?schema=public

# Auth
JWT_SECRET=smart-toilet-genie-secret-change-me
JWT_EXPIRES_IN=7d

# CORS Configuration
# Set to "*" to allow all origins (default), or specify a URL like "http://localhost:5173"
# WARNING: Using "*" disables credentials (cookies, authorization headers)
CORS_ORIGIN=*

# Logging Configuration
# Log levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
